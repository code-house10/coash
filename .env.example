# Copy to .env.local and fill in.

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required. The private code the first (admin) account signs up with.
SETUP_CODE=

# Personal mode: set to 1 to remove the sign-in page. Anyone who has the URL then gets in as the owner,
# so only use it for a private app and keep the URL to yourself. SETUP_CODE is not needed in this mode.
OPEN_ACCESS=

# Required on serverless hosts (Vercel): a Turso database. https://turso.tech
# Without these the app uses the local file data/app.db (fine for development).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: backup voice path through Groq (faster STT). Without it the backup uses Gemini text.
# With it, situations, corrections, tests and reports also use Groq first and fall back to Gemini.
GROQ_API_KEY=

# Optional model overrides.
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: push reminders. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Call GET /api/cron/remind?key=CRON_SECRET hourly from any scheduler.
CRON_SECRET=
