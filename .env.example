# Copy to .env.local and fill in.

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required. The private code the first (admin) account signs up with.
SETUP_CODE=

# Optional: backup voice path through Groq (faster STT). Without it the backup uses Gemini text.
GROQ_API_KEY=

# Optional model overrides.
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: push reminders. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Call GET /api/cron/remind?key=CRON_SECRET hourly from any scheduler.
CRON_SECRET=
